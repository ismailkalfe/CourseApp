@model Candidate

<div>
    <h3 class="display-4">Congrulations @Model.FullName</h3>
    <p class="lead">Your Application has been <mark>accepted.</mark></p>
    <p class="lead">Many thanks for your interest.</p>
    <hr>
    <blockquote class="blockquotue">
        You have enrolled to @Model.SelectedCourse course.
    </blockquote>
    <blockquote>
        <p class="text-muted">You applied at @Model.ApplyAt .</p>
    </blockquote>
    <div class="btn-group">
        <a class="btn btn-outline-success" asp-controller="Course" asp-action="Index">Application</a>
        <a class="btn btn-outline-success" asp-action="Index" asp-controller="home">Home</a>
    </div>
</div>